<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sprinkler.Core</AssemblyName>
    <RootNamespace>Sprinkler.Core</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/icon-256.png" LogicalName="icon-256.png" />
    <EmbeddedResource Include="Locales/*.json" LogicalName="Locales.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Sprinkler" />
    <InternalsVisibleTo Include="Sprinkler.Tests" />
  </ItemGroup>

</Project>
