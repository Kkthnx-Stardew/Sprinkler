<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sprinkler.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Sprinkler/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#D99A2B" RegionColor="#F7F2E7" ErrorText="#A33527" />
        <ColorPaletteResources x:Key="Dark" Accent="#E8A93D" RegionColor="#1E1713" ErrorText="#F28B7B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Sprinkler/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
