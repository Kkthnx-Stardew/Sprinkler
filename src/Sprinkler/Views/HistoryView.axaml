<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sprinkler.ViewModels"
             xmlns:ctl="using:Sprinkler.Controls"
             x:Class="Sprinkler.Views.HistoryView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Border Classes="panel" MaxWidth="980" Margin="20,8,20,24">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="clock" Size="22" /><TextBlock Classes="h2" Text="History and backups" /></StackPanel>
        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding BackupsText}" />
        <Button Classes="link" Command="{Binding RevealCommand}" CommandParameter="backups" HorizontalAlignment="Left"><TextBlock Classes="small" Text="Open the backup folder" /></Button>

        <StackPanel IsVisible="{Binding NoHistory}" Spacing="10" Margin="0,24" HorizontalAlignment="Center">
          <ctl:IconView Kind="shield" Size="44" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Text="Nothing has been changed yet. Updates you make will show up here, ready to undo." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding HasHistory}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryViewModel">
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="12">
                  <ctl:IconView Kind="{Binding ArtKind}" Size="22" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Classes="chip" IsVisible="{Binding Undone}"><TextBlock Text="Undone" /></Border>
                    <Button Classes="slim" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"><TextBlock Text="Undo" /></Button>
                    <TextBlock Classes="muted small" Text="Backup removed" IsVisible="{Binding BackupGone}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
