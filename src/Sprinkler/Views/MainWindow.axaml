<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sprinkler.Localization"
        xmlns:vm="using:Sprinkler.ViewModels"
        xmlns:ctl="using:Sprinkler.Controls"
        xmlns:v="using:Sprinkler.Views"
        x:Class="Sprinkler.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sprinkler" Width="1120" Height="820" MinWidth="760" MinHeight="540"
        Icon="avares://Sprinkler/Assets/icon-256.png"
        DragDrop.AllowDrop="True">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ConfirmDialogViewModel"><v:ConfirmDialogView /></DataTemplate>
    <DataTemplate DataType="vm:TourDialogViewModel"><v:TourDialogView /></DataTemplate>
    <DataTemplate DataType="vm:TextPromptDialogViewModel"><v:TextPromptDialogView /></DataTemplate>
    <DataTemplate DataType="vm:CollectionPreviewDialogViewModel"><v:CollectionPreviewDialogView /></DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
      <!-- ===== header ===== -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid MaxWidth="980" Margin="20,12" ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="logo">
              <Image Source="avares://Sprinkler/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="h1" Text="Sprinkler" />
              <WrapPanel x:Name="Chips" Orientation="Horizontal">
                <Border Classes="chip" MinHeight="26" Margin="0,0,6,0" IsVisible="{Binding HasGame}"><TextBlock Text="{Binding GameChip}" /></Border>
                <Border Classes="chip ok" MinHeight="26" Margin="0,0,6,0" IsVisible="{Binding HasSmapi}"><TextBlock Text="{Binding SmapiChip}" /></Border>
                <Border Classes="chip bad" MinHeight="26" Margin="0,0,6,0" IsVisible="{Binding NoSmapi}"><TextBlock Text="{Binding SmapiChip}" /></Border>
                <Border Classes="chip ok" MinHeight="26" Margin="0,0,6,0" IsVisible="{Binding NexusConnected}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><ctl:IconView Kind="key" Size="13" /><TextBlock Text="{Binding NexusChip}" /></StackPanel>
                </Border>
                <Button Classes="chipbtn" Margin="0,0,6,0" IsVisible="{Binding NexusNotConnected}" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppTab.Settings}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><ctl:IconView Kind="key" Size="13" /><TextBlock Text="{loc:T ui.connect_nexus}" /></StackPanel>
                </Button>
                <Button Classes="chipbtn" Margin="0,0,6,0" IsVisible="{Binding HasActiveProfile}" MaxWidth="{Binding #Chips.Bounds.Width}" Command="{Binding GoToCommand}" CommandParameter="{x:Static vm:AppTab.Profiles}" ToolTip.Tip="{Binding ProfileChipText}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><ctl:IconView Kind="layers" Size="13" /><TextBlock Grid.Column="1" Text="{Binding ProfileChipText}" TextTrimming="CharacterEllipsis" /></Grid>
                </Button>
                <Button Classes="chipbtn" Margin="0,0,6,0" IsVisible="{Binding HasAppUpdate}" IsEnabled="{Binding !AppUpdateBusy}" MaxWidth="{Binding #Chips.Bounds.Width}" Command="{Binding OpenAppUpdateCommand}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><ctl:IconView Kind="gift" Size="13" /><TextBlock Grid.Column="1" Text="{Binding AppUpdateText}" TextTrimming="CharacterEllipsis" /></Grid>
                </Button>
              </WrapPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="chip warn" IsVisible="{Binding GameRunning}"><TextBlock Text="{loc:T ui.game_is_running}" /></Border>
            <Button Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" IsVisible="{Binding HasGame}">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="refresh" Size="16" /><TextBlock Text="{loc:T ui.check_again}" /></StackPanel>
            </Button>
            <Button Classes="primary" Command="{Binding LaunchCommand}" IsVisible="{Binding CanPlay}" ToolTip.Tip="{loc:T ui.start_stardew_valley_through_smapi}">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="play" Size="15" /><TextBlock Text="{loc:T ui.play}" /></StackPanel>
            </Button>
            <Button Classes="icon" Command="{Binding ShowTourFromStartCommand}" ToolTip.Tip="{loc:T ui.quick_tour_and_help}" AutomationProperties.Name="{loc:T ui.quick_tour}">
              <ctl:IconView Kind="help" Size="18" />
            </Button>
            <Button Classes="icon" Command="{Binding CycleThemeCommand}" ToolTip.Tip="{loc:T ui.switch_light_or_dark}" AutomationProperties.Name="{loc:T ui.switch_theme}">
              <ctl:IconView Kind="{Binding ThemeIcon}" Size="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== tabs ===== -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <ScrollViewer x:Name="TabScroller" MaxWidth="1020" Padding="20,6,20,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ListBox x:Name="TabStrip" Classes="tabs" SelectedIndex="{Binding TabIndex}" SelectionChanged="OnTabChanged" HorizontalAlignment="Left" AutomationProperties.Name="{loc:T ui.sections}">
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:IconView Classes="tabicon" Kind="arrowup" Size="17" /><TextBlock Text="{loc:T ui.updates}" />
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="99" MinWidth="20" Padding="6,0" IsVisible="{Binding HasUpdateCount}" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" />
              </Border>
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Classes="tabicon" Kind="package" Size="17" /><TextBlock Text="{loc:T ui.all_mods}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Classes="tabicon" Kind="layers" Size="17" /><TextBlock Text="{loc:T ui.profiles}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Classes="tabicon" Kind="clock" Size="17" /><TextBlock Text="{loc:T ui.history}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Classes="tabicon" Kind="sliders" Size="17" /><TextBlock Text="{loc:T ui.nexus_and_settings}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Classes="tabicon" Kind="book" Size="17" /><TextBlock Text="{loc:T ui.help}" /></StackPanel></ListBoxItem>
        </ListBox>
        </ScrollViewer>
      </Border>

      <!-- ===== notices that apply to every tab ===== -->
      <ScrollViewer x:Name="NoticeScroller" Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <v:NoticesView MaxWidth="980" Margin="20,0" />
      </ScrollViewer>

      <!-- ===== the tabs ===== -->
      <Panel Grid.Row="3">
        <v:UpdatesView IsVisible="{Binding ShowUpdatesTab}" />
        <v:ModsView IsVisible="{Binding ShowModsTab}" />
        <v:ProfilesView IsVisible="{Binding ShowProfilesTab}" />
        <v:HistoryView IsVisible="{Binding ShowHistoryTab}" />
        <v:SettingsView IsVisible="{Binding ShowSettingsTab}" />
        <v:HelpView IsVisible="{Binding ShowHelpTab}" />
      </Panel>
    </Grid>

    <!-- ===== toasts ===== -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Border Classes="toast" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ctl:IconView Kind="{Binding Kind}" Size="20" Foreground="{DynamicResource GoodBrush}" IsVisible="{Binding !IsBad}" />
              <ctl:IconView Kind="{Binding Kind}" Size="20" Foreground="{DynamicResource BadBrush}" IsVisible="{Binding IsBad}" />
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="300" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== dialogs ===== -->
    <Grid IsVisible="{Binding HasDialog}" Background="{DynamicResource ScrimBrush}">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
    </Grid>

    <!-- ===== drop target ===== -->
    <Border x:Name="DropOverlay" IsVisible="False" Background="#E6E8A93D" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <ctl:IconView Kind="upload" Size="56" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:T ui.drop_a_mod_zip_7z_or_rar_to_install_it}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentInkBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
