<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sprinkler.Localization"
             xmlns:vm="using:Sprinkler.ViewModels"
             xmlns:ctl="using:Sprinkler.Controls"
             xmlns:v="using:Sprinkler.Views"
             x:Class="Sprinkler.Views.ModsView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer x:Name="Page" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Grid x:Name="Body" MaxWidth="980" Margin="20,8,20,20">
    <Border Classes="panel center" IsVisible="{Binding NoMods}" VerticalAlignment="Top">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <ctl:IconView Kind="package" Size="48" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="{loc:T ui.no_mods_found_yet}" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{loc:T ui.put_mods_in_your_mods_folder_or_drop_a_downl}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Classes="panel" IsVisible="{Binding HasMods}" Margin="0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="package" Size="22" /><TextBlock Classes="h2" Text="{Binding ModsTitle}" /></StackPanel>
        <Expander Grid.Row="1" Classes="flat optional" Header="{loc:T ui.about_this_list}"><TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.use_the_switch_to_turn_a_mod_off_or_on_smapi}" /></Expander>
        <StackPanel Grid.Row="2" Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBox Text="{Binding ModSearch}" PlaceholderText="{loc:T ui.search_mods_or_authors}" AutomationProperties.Name="{loc:T ui.search_mods}" />
            <ComboBox Grid.Column="1" SelectedIndex="{Binding ModSortIndex}" MinWidth="210" AutomationProperties.Name="{loc:T ui.sort_mods}">
              <ComboBoxItem Content="{loc:T ui.needs_attention_first}" />
              <ComboBoxItem Content="{loc:T ui.name}" />
              <ComboBoxItem Content="{loc:T ui.author}" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox IsChecked="{Binding GroupPacks}" Content="{loc:T ui.group_content_packs_under_their_mod}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" ToolTip.Tip="{loc:T ui.switch_shown_tip}">
              <Button Classes="slim" Command="{Binding SwitchShownOnCommand}"><TextBlock Text="{loc:T ui.switch_all_on}" /></Button>
              <Button Classes="slim" Command="{Binding SwitchShownOffCommand}"><TextBlock Text="{loc:T ui.switch_all_off}" /></Button>
            </StackPanel>
          </Grid>
        </StackPanel>
        <ItemsControl Grid.Row="3" ItemsSource="{Binding ModChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChipViewModel">
              <ToggleButton Classes="filter" IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding PickCommand}" Margin="0,0,6,6"><TextBlock Text="{Binding Text}" /></ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="4" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="52,2.2*,90,*,36" ColumnSpacing="12" Margin="4,6" IsHitTestVisible="False">
            <TextBlock Classes="muted small strong" Text="{loc:T ui.on}" />
            <TextBlock Grid.Column="1" Classes="muted small strong" Text="{loc:T ui.mod}" />
            <TextBlock Grid.Column="2" Classes="muted small strong" Text="{loc:T ui.version}" />
            <TextBlock Grid.Column="3" Classes="muted small strong" Text="{loc:T ui.status}" />
          </Grid>
          <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid>
              <TextBlock Classes="muted" Text="{loc:T ui.nothing_matches}" HorizontalAlignment="Center" Margin="0,30" IsVisible="{Binding NoModMatches}" />
              <ListBox Classes="plain" ItemsSource="{Binding Mods}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModRowViewModel">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{Binding RowPadding}" Opacity="{Binding RowOpacity}">
                      <Grid ColumnDefinitions="52,2.2*,90,*,36" ColumnSpacing="12">
                        <!-- a thin rail beside the content packs ties them to the mod above -->
                        <Border Grid.ColumnSpan="5" IsVisible="{Binding Indented}" Width="2" HorizontalAlignment="Left" Margin="76,-12,0,-12" Opacity="0.55"
                                Background="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
                        <ToggleSwitch IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" ToolTip.Tip="{Binding SwitchTip}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center" Margin="{Binding Indent}" ToolTip.Tip="{Binding Summary}">
                        <v:ModIconView DataContext="{Binding}" Width="{Binding IconSize}" Height="{Binding IconSize}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Classes="chipbtn" Height="22" MinHeight="22" Margin="8,0,0,0" Command="{Binding TogglePacksCommand}" IsVisible="{Binding IsParent}"
                                    AutomationProperties.Name="{Binding PacksText}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <ctl:IconView Kind="chevron" Size="12" VerticalAlignment="Center" RenderTransform="{Binding ChevronTurn}" />
                                <TextBlock Text="{Binding PacksText}" FontSize="11.5" />
                              </StackPanel>
                            </Button>
                            <Border DockPanel.Dock="Right" Classes="tag" Margin="8,0,0,0" IsVisible="{Binding ShowPackTag}"><TextBlock Text="{loc:T ui.content_pack}" /></Border>
                            <Border DockPanel.Dock="Right" Classes="tag" Margin="8,0,0,0" IsVisible="{Binding IsEndorsed}"><StackPanel Orientation="Horizontal" Spacing="4"><ctl:IconView Kind="heart" Size="11" /><TextBlock Text="{loc:T ui.endorsed}" /></StackPanel></Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                          <TextBlock Classes="muted small" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetaFull}" />
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasNote}">
                            <ctl:IconView Kind="edit" Size="12" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Classes="small accent" FontStyle="Italic" Text="{Binding NoteText}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasNeeds}">
                            <ctl:IconView Kind="alert" Size="14" Foreground="{DynamicResource WarnBrush}" />
                            <TextBlock Classes="warn small strong" Text="{Binding NeedsText}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                          <Border Classes="chip" Classes.ok="{Binding ChipOk}" Classes.warn="{Binding ChipWarn}" Classes.bad="{Binding ChipBad}" Margin="0,0,6,0"><TextBlock Text="{Binding StatusText}" /></Border>
                          <Button Classes="chipbtn" Command="{Binding OpenUnofficialCommand}" IsVisible="{Binding HasUnofficial}" ToolTip.Tip="{loc:T ui.a_community_fix_exists_that_is_not_the_mod_a}"><TextBlock Text="{Binding UnofficialText}" /></Button>
                        </WrapPanel>
                        <Button Grid.Column="4" Classes="icon ghost" Width="32" Height="32" MinHeight="32" VerticalAlignment="Center" AutomationProperties.Name="{loc:T ui.more_actions}" ToolTip.Tip="{loc:T ui.more_actions}">
                          <ctl:IconView Kind="more" Size="20" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="{loc:T ui.open_the_mod_page}" Command="{Binding OpenPageCommand}" IsVisible="{Binding HasUrl}" />
                              <MenuItem Header="{loc:T ui.show_the_folder}" Command="{Binding ShowFolderCommand}" />
                              <MenuItem Header="{loc:T ui.open_its_settings_file}" Command="{Binding OpenConfigCommand}" IsVisible="{Binding HasConfig}" />
                              <MenuItem Header="{Binding NoteMenuText}" Command="{Binding EditNoteCommand}" />
                              <MenuItem Header="{Binding EndorseText}" Command="{Binding ToggleEndorsementCommand}" IsVisible="{Binding CanEndorse}" />
                              <MenuItem Header="{Binding StopSkippingText}" Command="{Binding StopSkippingCommand}" IsVisible="{Binding HasSkipped}" />
                              <MenuItem Header="{Binding IgnoreText}" Command="{Binding ToggleIgnoreCommand}" IsVisible="{Binding CanIgnore}" />
                              <MenuItem Header="{loc:T ui.remove_this_mod}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
