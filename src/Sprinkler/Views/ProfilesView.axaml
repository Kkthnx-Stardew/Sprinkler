<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sprinkler.Localization"
             xmlns:vm="using:Sprinkler.ViewModels"
             xmlns:ctl="using:Sprinkler.Controls"
             x:Class="Sprinkler.Views.ProfilesView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="980" Margin="20,8,20,24">

      <!-- what a profile is, and the current one -->
      <Border Classes="panel">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="layers" Size="22" /><TextBlock Classes="h2" Text="{loc:T ui.profiles}" /></StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T ui.a_profile_remembers_which_mods_are_switched}" />

          <Border Classes="banner ok" IsVisible="{Binding HasActiveProfile}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ctl:IconView Kind="check" Size="20" VerticalAlignment="Top" />
              <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding ActiveProfileLine}" />
            </StackPanel>
          </Border>

          <Border Classes="banner warn" IsVisible="{Binding ProfileModified}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <ctl:IconView Kind="alert" Size="20" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" Text="{Binding ProfileModifiedText}" />
              <Button Grid.Column="2" Classes="slim primary" Command="{Binding SaveProfileChangesCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6"><ctl:IconView Kind="save" Size="14" /><TextBlock Text="{loc:T ui.save_changes}" /></StackPanel>
              </Button>
            </Grid>
          </Border>

          <Border Classes="banner info" IsVisible="{Binding NoActiveProfile}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ctl:IconView Kind="help" Size="20" VerticalAlignment="Top" />
              <TextBlock Classes="body" TextWrapping="Wrap" Text="{loc:T ui.no_profile_is_active_the_mods_that_are_switc}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- new -->
      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Margin="0" Text="{loc:T ui.save_what_is_switched_on_now}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewProfileName}" MaxLength="60" PlaceholderText="{loc:T ui.a_name_for_example_co_op_farm}" AutomationProperties.Name="{loc:T ui.profile_name}">
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding CreateProfileCommand}" /></TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="primary" Command="{Binding CreateProfileCommand}" IsEnabled="{Binding CanCreateProfile}">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="save" Size="16" /><TextBlock Text="{loc:T ui.save_as_a_profile}" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding ImportProfileCommand}" ToolTip.Tip="{loc:T ui.open_a_profile_a_friend_sent_you}">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="upload" Size="16" /><TextBlock Text="{loc:T ui.open_a_shared_profile}" /></StackPanel>
            </Button>
          </Grid>
          <CheckBox IsChecked="{Binding KeepConfigs}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{loc:T ui.each_profile_keeps_its_own_mod_settings}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.saves_every_mod_s_config_json_with_the_profi}" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>

      <!-- a Nexus collection -->
      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Margin="0" Text="{loc:T ui.add_a_nexus_collection}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.collections_are_lists_of_mods_that_other_pla}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding CollectionAddress}" PlaceholderText="https://www.nexusmods.com/games/stardewvalley/collections/..." AutomationProperties.Name="{loc:T ui.collection_address}">
              <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding LookUpCollectionCommand}" /></TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Command="{Binding LookUpCollectionCommand}" IsEnabled="{Binding CanLookUp}">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="search" Size="16" /><TextBlock Text="{Binding LookUpText}" /></StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- the list -->
      <Border Classes="panel center" IsVisible="{Binding NoProfiles}">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <ctl:IconView Kind="layers" Size="44" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Text="{loc:T ui.no_profiles_yet_switch_your_mods_on_and_off}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding ProfileList}" IsVisible="{Binding HasProfiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileViewModel">
            <Border Classes="card" Classes.done="{Binding IsActive}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="16,14">
                <Border Classes="art"><ctl:IconView Kind="layers" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                    <Border Classes="chip ok" IsVisible="{Binding IsActive}"><TextBlock Text="{loc:T ui.active}" /></Border>
                  </StackPanel>
                  <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCollection}">
                    <ctl:IconView Kind="gift" Size="13" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="small info" Text="{Binding CollectionText}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="primary" Command="{Binding SwitchCommand}" IsVisible="{Binding CanSwitch}"><TextBlock Text="{loc:T ui.switch_to_it}" /></Button>
                  <Button Classes="icon ghost" Width="34" Height="34" MinHeight="34" AutomationProperties.Name="{loc:T ui.more_actions}" ToolTip.Tip="{loc:T ui.more_actions}">
                    <ctl:IconView Kind="more" Size="20" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{loc:T ui.stop_installing_the_rest_of_this_collection}" Command="{Binding StopInstallingCommand}" IsVisible="{Binding Pending}" />
                        <MenuItem Header="{loc:T ui.rename}" Command="{Binding RenameCommand}" />
                        <MenuItem Header="{loc:T ui.make_a_copy}" Command="{Binding CopyCommand}" />
                        <MenuItem Header="{loc:T ui.save_to_share}" Command="{Binding ExportCommand}" />
                        <MenuItem Header="{loc:T ui.delete}" Command="{Binding DeleteCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
