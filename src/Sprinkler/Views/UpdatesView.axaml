<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Sprinkler.Localization"
             xmlns:vm="using:Sprinkler.ViewModels"
             xmlns:ctl="using:Sprinkler.Controls"
             xmlns:v="using:Sprinkler.Views"
             x:Class="Sprinkler.Views.UpdatesView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="980" Margin="20,8,20,24">

        <!-- progress steps -->
        <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}" Margin="0,8,0,4">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StepViewModel">
              <Border Classes="step" Classes.on="{Binding IsOn}" Classes.done="{Binding IsDone}" Margin="0,0,6,0"><TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" /></Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- starting -->
        <Border Classes="panel center" IsVisible="{Binding IsStarting}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Image Source="avares://Sprinkler/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{loc:T ui.looking_for_stardew_valley}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- choose the game -->
        <Border Classes="panel" IsVisible="{Binding IsChoosing}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="folder" Size="22" /><TextBlock Classes="h2" Text="{Binding ChooseTitle}" /></StackPanel>
            <TextBlock Classes="muted" Text="{Binding ChooseText}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Candidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CandidateViewModel">
                  <Button Command="{Binding Pick}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="42" Margin="0,3">
                    <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="folder" Size="16" /><TextBlock Text="{Binding Text}" /></StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GamePathInput}" PlaceholderText="{Binding GamePathExample}" AutomationProperties.Name="{loc:T ui.game_folder}" />
              <Button Grid.Column="1" Command="{Binding BrowseGameFolderCommand}"><TextBlock Text="{loc:T ui.browse}" /></Button>
              <Button Grid.Column="2" Classes="primary" Command="{Binding UseTypedGamePathCommand}"><TextBlock Text="{loc:T ui.use_this_folder}" /></Button>
            </Grid>
            <TextBlock Classes="bad small strong" Text="{Binding GamePathError}" IsVisible="{Binding HasGamePathError}" TextWrapping="Wrap" />
            <Expander Classes="flat" Header="{loc:T ui.how_do_i_find_the_folder}">
              <TextBlock Classes="muted small" Text="{Binding FindGameHelp}" TextWrapping="Wrap" />
            </Expander>
          </StackPanel>
        </Border>

        <!-- scanning and checking -->
        <Border Classes="panel center" IsVisible="{Binding IsWorking}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Image Source="avares://Sprinkler/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{Binding StatusText}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" Text="{loc:T ui.the_app_reads_each_mod_s_manifest_then_asks}" />
          </StackPanel>
        </Border>

        <!-- the check did not finish -->
        <Border Classes="panel center" IsVisible="{Binding IsIdle}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <ctl:IconView Kind="alert" Size="44" Foreground="{DynamicResource WarnBrush}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{loc:T ui.the_check_did_not_finish}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{loc:T ui.see_the_message_above_then_try_again}" HorizontalAlignment="Center" />
            <Button Classes="primary big" Command="{Binding CheckCommand}" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="refresh" Size="18" /><TextBlock Text="{loc:T ui.try_again}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- welcome -->
        <Border Classes="panel" IsVisible="{Binding ShowWelcome}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="avares://Sprinkler/Assets/logo.png" Width="28" Height="28" /><TextBlock Classes="h2" Text="{loc:T ui.welcome}" /></StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{loc:T ui.sprinkler_keeps_your_stardew_valley_mods_up}" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="muted" Text="{loc:T ui.game_folder}" /><SelectableTextBlock Grid.Column="1" Text="{Binding GamePath}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Classes="muted" Text="{loc:T ui.mods_folder}" /><SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModsPath}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Classes="muted" Text="SMAPI" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SmapiFoundText}" TextWrapping="Wrap" />
            </Grid>
            <UniformGrid Columns="3" Margin="0,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,12,0"><ctl:IconView Kind="shield" Size="22" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Classes="strong" Text="{loc:T ui.nothing_changes_yet}" /><TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.you_see_the_plan_first_and_press_update_your}" /></StackPanel></Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,12,0"><ctl:IconView Kind="package" Size="22" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Classes="strong" Text="{loc:T ui.backups_and_undo}" /><TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.every_mod_is_saved_before_it_is_replaced_you}" /></StackPanel></Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><ctl:IconView Kind="key" Size="22" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Classes="strong" Text="{loc:T ui.no_hidden_accounts}" /><TextBlock Classes="muted small" TextWrapping="Wrap" Text="{loc:T ui.no_ads_no_tracking_your_nexus_key_stays_on_t}" /></StackPanel></Grid>
            </UniformGrid>
            <TextBlock Classes="muted small" Text="{loc:T ui.wrong_folder_change_it_under_nexus_and_setti}" />
            <Button Classes="primary big" Command="{Binding ConfirmWelcomeCommand}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="check" Size="18" /><TextBlock Text="{loc:T ui.looks_right_continue}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- SMAPI has an update -->
        <Border Classes="banner info" IsVisible="{Binding HasSmapiUpdate}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ctl:IconView Kind="gift" Size="20" VerticalAlignment="Top" />
            <StackPanel Spacing="4"><TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding SmapiUpdateText}" /><Button Classes="link" Command="{Binding OpenSmapiUpdateCommand}"><TextBlock Text="{loc:T ui.get_smapi}" /></Button></StackPanel>
          </StackPanel>
        </Border>

        <!-- overview -->
        <StackPanel IsVisible="{Binding IsReview}">
          <Border Classes="hero">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
              <Border Classes="heroart"><Image Source="avares://Sprinkler/Assets/logo.png" Width="60" Height="60" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Classes="hero" Text="{Binding HeroTitle}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding HeroText}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="primary big" Command="{Binding LaunchCommand}" IsVisible="{Binding HeroPlay}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="play" Size="16" /><TextBlock Text="{loc:T ui.play_stardew_valley}" /></StackPanel>
              </Button>
            </Grid>
          </Border>
          <UniformGrid Columns="4" Margin="0,7">
            <Button Classes="tile" Command="{Binding ShowFilterCommand}" CommandParameter="all" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal" Spacing="12"><Border Classes="dot"><ctl:IconView Kind="package" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Classes="count" Text="{Binding CountAll}" /><TextBlock Classes="muted small" Text="{loc:T ui.mods_in_your_folder}" /></StackPanel></StackPanel>
            </Button>
            <Button Classes="tile" Command="{Binding ShowFilterCommand}" CommandParameter="update" Margin="3,0">
              <StackPanel Orientation="Horizontal" Spacing="12"><Border Classes="dot"><ctl:IconView Kind="arrowup" Size="22" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Classes="count" Text="{Binding CountUpdates}" /><TextBlock Classes="muted small" Text="{loc:T ui.updates_or_installs}" /></StackPanel></StackPanel>
            </Button>
            <Button Classes="tile" Command="{Binding ShowFilterCommand}" CommandParameter="ok" Margin="3,0">
              <StackPanel Orientation="Horizontal" Spacing="12"><Border Classes="dot"><ctl:IconView Kind="check" Size="22" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Classes="count" Text="{Binding CountUpToDate}" /><TextBlock Classes="muted small" Text="{loc:T ui.up_to_date}" /></StackPanel></StackPanel>
            </Button>
            <Button Classes="tile" Command="{Binding ShowFilterCommand}" CommandParameter="nocheck" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="12"><Border Classes="dot"><ctl:IconView Kind="help" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel><TextBlock Classes="count" Text="{Binding CountUnchecked}" /><TextBlock Classes="muted small" Text="{loc:T ui.cannot_be_checked}" /></StackPanel></StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>

        <!-- what SMAPI said about the last session -->
        <Border Classes="panel warnedge" IsVisible="{Binding HealthVisible}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="alert" Size="22" Foreground="{DynamicResource WarnBrush}" /><TextBlock Classes="h2" Text="{Binding HealthTitle}" TextWrapping="Wrap" /></StackPanel>
            <TextBlock Classes="muted small" Text="{Binding HealthSubtitle}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SkippedMods}" IsVisible="{Binding HasSkippedMods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SkippedModViewModel">
                  <StackPanel Margin="0,4"><TextBlock Classes="strong" Text="{Binding Title}" /><TextBlock Classes="small" Text="{Binding Reason}" TextWrapping="Wrap" /><TextBlock Classes="muted small" Text="{Binding Hint}" TextWrapping="Wrap" /></StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Classes="flat" Header="{loc:T ui.mods_that_logged_errors}" IsVisible="{Binding HasLogErrors}">
              <ItemsControl ItemsSource="{Binding LogErrors}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LogErrorViewModel"><TextBlock Classes="small" Text="{Binding Text}" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="slim" Command="{Binding CheckCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><ctl:IconView Kind="refresh" Size="14" /><TextBlock Text="{loc:T ui.check_again}" /></StackPanel></Button>
              <Button Classes="slim" Command="{Binding DismissLogCommand}"><TextBlock Text="{loc:T ui.dismiss_until_the_next_game_session}" /></Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- tick what you want -->
        <Border Classes="panel tight" IsVisible="{Binding ShowTickPanel}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="arrowup" Size="20" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Classes="strong" Text="{loc:T ui.tick_what_you_want_then_press_update}" /></StackPanel>
            <Expander Classes="flat" Header="{loc:T ui.what_do_the_labels_mean}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="tag auto"><TextBlock Text="{loc:T ui.automatic}" /></Border><TextBlock Classes="small" Text="{loc:T ui.the_app_downloads_and_installs_it_by_itself}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="tag click"><TextBlock Text="{loc:T ui.one_click}" /></Border><TextBlock Classes="small" Text="{loc:T ui.you_click_mod_manager_download_on_nexus_and}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="tag click"><TextBlock Text="{loc:T ui.you_download}" /></Border><TextBlock Classes="small" Text="{loc:T ui.you_press_the_download_button_on_the_site_th}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="tag new"><TextBlock Text="{loc:T ui.new_install}" /></Border><TextBlock Classes="small" Text="{loc:T ui.a_mod_you_need_but_do_not_have_yet_smapi_ski}" TextWrapping="Wrap" /></StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- finished -->
        <Border Classes="panel center" IsVisible="{Binding IsFinished}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <ctl:IconView Kind="check" Size="52" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{loc:T ui.finished}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding FinishedText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <Button Classes="primary big" Command="{Binding LaunchCommand}" IsVisible="{Binding CanPlay}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="play" Size="16" /><TextBlock Text="{loc:T ui.play_stardew_valley}" /></StackPanel></Button>
              <Button Classes="big" Command="{Binding BackToReviewCommand}"><TextBlock Text="{loc:T ui.back_to_the_list}" /></Button>
              <Button Classes="big" Command="{Binding CheckCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="refresh" Size="16" /><TextBlock Text="{loc:T ui.check_again}" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- the update cards -->
        <ItemsControl ItemsSource="{Binding VisibleItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemViewModel"><v:UpdateCardView /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- things the app noticed -->
        <Border Classes="panel" IsVisible="{Binding HasProblems}">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10"><ctl:IconView Kind="alert" Size="22" Foreground="{DynamicResource WarnBrush}" /><TextBlock Classes="h2" Text="{loc:T ui.heads_up}" /></StackPanel>
            <TextBlock Classes="muted small" Text="{loc:T ui.things_the_app_noticed_that_may_affect_your}" />
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProblemViewModel">
                  <Border Classes="banner warn" Classes.bad="{Binding IsError}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="body small" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <Button Classes="link" Command="{Binding Open}" IsVisible="{Binding HasLink}"><TextBlock Text="{Binding LinkText}" /></Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- the update bar stays at the bottom -->
    <Border Grid.Row="1" Padding="20,0,20,16" IsVisible="{Binding ShowActions}">
      <Border Classes="actions" MaxWidth="980">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
          <Button Classes="primary big" Command="{Binding UpdateSelectedCommand}" IsEnabled="{Binding CanUpdate}">
            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:IconView Kind="arrowup" Size="18" /><TextBlock Text="{Binding UpdateButtonText}" /></StackPanel>
          </Button>
          <Button Grid.Column="1" Command="{Binding SelectAllCommand}"><TextBlock Text="{loc:T ui.select_all}" /></Button>
          <Button Grid.Column="2" Command="{Binding SelectNoneCommand}"><TextBlock Text="{loc:T ui.select_none}" /></Button>
          <TextBlock Grid.Column="4" Classes="warn small strong" Text="{loc:T ui.close_the_game_to_continue}" IsVisible="{Binding GameRunning}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
